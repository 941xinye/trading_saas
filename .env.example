APP_NAME="币圈交易 SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# 沿用 CRM 约定：默认中文 locale
APP_LOCALE=zh_CN
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=zh_CN

APP_MAINTENANCE_DRIVER=file

# Octane + Swoole
OCTANE_SERVER=swoole
OCTANE_HOST=0.0.0.0
OCTANE_PORT=8000
OCTANE_WORKERS=auto
OCTANE_MAX_REQUESTS=500

# Reverb WebSocket
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL 8.4（ServBay 默认）
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=crypto_saas
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=crypto

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# 邮件（Mailpit/SMTP）
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@crypto-saas.local"
MAIL_FROM_NAME="${APP_NAME}"

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org

# 企业微信
WECHAT_WORK_WEBHOOK=
WECHAT_WORK_KEY=
NOTIFY_MAIL_TO=

# AI Provider - OpenAI
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# AI Provider - DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_DEFAULT_MODEL=deepseek-chat

# AI Provider - 通义千问
QWEN_API_KEY=
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_DEFAULT_MODEL=qwen-plus

# AI Provider - Local Ollama
OLLAMA_API_BASE=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:14b

# 交易所主密钥（KEK）- 用于加密租户 DEK，绝不入库（64 位 hex = 32 字节，php -r "echo bin2hex(random_bytes(32));"）
EXCHANGE_MASTER_KEY=

# 交易所默认端点
EXCHANGE_BINANCE_REST=https://api.binance.com
EXCHANGE_BINANCE_WS=wss://stream.binance.com:9443/stream
EXCHANGE_BINANCE_FUTURES_REST=https://fapi.binance.com
EXCHANGE_BINANCE_FUTURES_WS=wss://fstream.binance.com/ws
# Binance 合约 testnet（独立于现货 testnet，需在 testnet.binancefuture.com 单独注册 key）
EXCHANGE_BINANCE_FUTURES_TESTNET_REST=https://testnet.binancefuture.com
EXCHANGE_BINANCE_FUTURES_TESTNET_WS=wss://stream.binancefuture.com/ws

# Binance testnet（P1 POC：EXCHANGE_BINANCE_TESTNET=true 时 REST/WS 自动切换到 testnet）
EXCHANGE_BINANCE_TESTNET=false
EXCHANGE_BINANCE_TESTNET_REST=https://testnet.binance.vision
EXCHANGE_BINANCE_TESTNET_WS=wss://stream.testnet.binance.vision:9443/stream
EXCHANGE_TESTNET_KEY=
EXCHANGE_TESTNET_SECRET=

# OKX 现货适配器（research.md R-001/R-005：testnet 同域 REST + wspap WS）
EXCHANGE_OKX_REST=https://www.okx.com
EXCHANGE_OKX_WS=wss://ws.okx.com:8443/ws/v5/public
EXCHANGE_OKX_TESTNET=false
EXCHANGE_OKX_TESTNET_WS=wss://wspap.okx.com:8443/ws/v5/public
EXCHANGE_OKX_KEY=
EXCHANGE_OKX_SECRET=
EXCHANGE_OKX_PASSPHRASE=

# Bybit 现货适配器（002 R-001：testnet 独立域名，无 passphrase）
EXCHANGE_BYBIT_REST=https://api.bybit.com
EXCHANGE_BYBIT_WS=wss://stream.bybit.com/v5/public/spot
EXCHANGE_BYBIT_TESTNET=false
EXCHANGE_BYBIT_TESTNET_REST=https://api-testnet.bybit.com
EXCHANGE_BYBIT_TESTNET_WS=wss://stream-testnet.bybit.com/v5/public/spot
EXCHANGE_BYBIT_KEY=
EXCHANGE_BYBIT_SECRET=

# Bitget 现货适配器（003 决定 A：无公开模拟盘，不含 TESTNET 变量）
EXCHANGE_BITGET_REST=https://api.bitget.com
EXCHANGE_BITGET_WS=wss://ws.bitget.com/v2/ws/public
EXCHANGE_BITGET_KEY=
EXCHANGE_BITGET_SECRET=
EXCHANGE_BITGET_PASSPHRASE=

# 签名请求 recvWindow（毫秒）
EXCHANGE_RECV_WINDOW=5000

# P8 ClickHouse 历史归档（spec 004 / R-001 env 键集，节点机 Docker 起 CH 单节点）
ARCHIVE_CH_HOST=127.0.0.1
ARCHIVE_CH_PORT=8123
ARCHIVE_CH_DATABASE=trading_archive
ARCHIVE_CH_USER=default
ARCHIVE_CH_PASSWORD=
ARCHIVE_CH_TIMEOUT_MS=30000

# 仓位级风控（spec 005，合约场景，保证金率阈值，越小越危险）
RISK_POSITION_WARNING=0.50
RISK_POSITION_ACTION=0.20
RISK_POSITION_EMERGENCY=0.10
RISK_POSITION_REDUCE_RATIO=0.50
RISK_POSITION_LOCK_TTL=30
RISK_POSITION_DEDUP=900

# P9 支付网关（spec 007：生产 MUST 显式 PAYMENT_CHANNEL=btcpay；fake 仅 local/testing）
PAYMENT_CHANNEL=fake
PAYMENT_INVOICE_TTL_MINUTES=30
# BTCPay Server 自托管（密钥留空占位，不入库不入 git）
BTCPAY_BASE_URL=
BTCPAY_STORE_ID=
BTCPAY_API_KEY=
BTCPAY_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"
